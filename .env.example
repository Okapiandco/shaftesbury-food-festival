# Sanity (public content only — page/event/sponsor/trade-stand copy)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_READ_TOKEN=your_read_token_here
SANITY_API_WRITE_TOKEN=your_write_token_here

# Postgres (Neon) — form submissions containing personal data live here,
# not in Sanity's public dataset. See db/schema.sql.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Email (Resend)
RESEND_API_KEY=re_your_key_here

# CSV Export (set a strong secret for production)
EXPORT_SECRET=your_export_secret_here

# Site
NEXT_PUBLIC_SITE_URL=https://www.shaftesbury-food-festival.co.uk

